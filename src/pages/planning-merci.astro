---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { icons } from '../data/icons';

/* Page de remerciement du planning : elle porte les deux liens de téléchargement.
   Noindex, hors sitemap (filtre « -merci » dans astro.config.mjs). Les PDF vivent dans
   site/public/planning/ sous un nom peu devinable, comme recommandé dans
   docs/reco-telechargement.md. */

const files = [
  { label: '0 à 2 ans', href: '/planning/planning-sommeil-0-2-ans-ps26.pdf', note: 'Repas et siestes rapprochés' },
  { label: '2 à 6 ans', href: '/planning/planning-sommeil-2-6-ans-ps26.pdf', note: 'Coucher, sieste unique, réveils' },
];
---
<Base
  title="Ton planning de sommeil est prêt"
  description="Télécharge le planning de sommeil sur 7 jours, version 0-2 ans ou 2-6 ans. A4 paysage, un stylo suffit."
  noindex
>
  <section class="merci">
    <div class="container inner">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17 19 7"/></svg>
      </span>

      <h1 data-merci-title>Merci, il est à toi</h1>
      <p class="lead">Choisis la version qui correspond à l’âge de ton enfant. Imprime-la en A4 paysage, pose-la près du lit avec un stylo, et note pendant sept jours.</p>

      <div class="files">
        {files.map((f) => (
          <a class="file" href={f.href} download>
            <span class="file-icon" set:html={icons.book} />
            <span class="file-body">
              <span class="file-label">Planning {f.label}</span>
              <span class="file-note">{f.note} · PDF, 140 Ko</span>
            </span>
            <span class="file-cta">Télécharger</span>
          </a>
        ))}
      </div>

      <div class="next">
        <p>Quand la semaine est remplie, le questionnaire prend cinq minutes et on peut se voir dans la foulée.</p>
        <div class="actions">
          <Button href="/questionnaire" variant="primary">Démarrer le questionnaire</Button>
          <Button href="/" variant="secondary">Retour à l’accueil</Button>
        </div>
      </div>

      <p class="sig">Doucement, pas à pas, vers des nuits plus sereines.</p>
    </div>
  </section>
</Base>

<style>
  .merci { padding: 96px 0 var(--section-y); }
  .inner { max-width: 640px; text-align: center; }
  .mark { width: 76px; height: 76px; border-radius: 50%; margin: 0 auto 28px; display: flex; align-items: center; justify-content: center; background: var(--cream-100); border: 1.5px solid var(--gold-400); color: var(--gold-600); }
  .mark svg { width: 34px; height: 34px; }
  h1 { margin-bottom: 14px; }
  .lead { color: var(--text-body); margin-bottom: 28px; }

  .files { display: flex; flex-direction: column; gap: 12px; text-align: left; margin-bottom: 36px; }
  .file {
    display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center;
    padding: 18px 20px; background: var(--navy-900); color: var(--text-on-dark);
    border-radius: var(--radius-lg); text-decoration: none;
    transition: transform var(--dur-base) var(--ease-soft), box-shadow var(--dur-base) var(--ease-soft);
  }
  .file:hover { transform: translateY(-2px); box-shadow: var(--shadow-navy); }
  .file:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 3px; }
  .file-icon { display: inline-flex; width: 44px; height: 44px; border-radius: 50%; align-items: center; justify-content: center; background: rgba(244,239,230,0.08); color: var(--gold-400); }
  .file-icon :global(svg) { width: 22px; height: 22px; }
  .file-label { display: block; font-family: var(--font-display); font-size: 20px; font-weight: var(--fw-bold); color: var(--text-on-dark); line-height: 1.2; }
  .file-note { display: block; font-size: var(--fs-xs); color: var(--text-on-dark-muted); margin-top: 3px; }
  .file-cta { font-size: var(--fs-sm); font-weight: var(--fw-bold); color: var(--navy-900); background: var(--gold-500); padding: 9px 14px; border-radius: var(--radius-pill); white-space: nowrap; }

  .next p { color: var(--text-body); margin: 0 0 16px; }
  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .sig { margin: 32px 0 0; font-family: var(--font-display); font-style: italic; color: var(--ink-500); }

  @media (max-width: 480px) {
    .file { grid-template-columns: auto 1fr; }
    .file-cta { grid-column: 1 / -1; text-align: center; }
    .actions { flex-direction: column; }
  }
</style>

<script>
  /* Prénom lu dans l'URL ? Non : Netlify redirige sans paramètre. On personnalise depuis le formulaire
     précédent uniquement si le navigateur a gardé la valeur en sessionStorage. */
  try {
    const p = sessionStorage.getItem('ps_planning_prenom');
    if (p) {
      const h1 = document.querySelector<HTMLElement>('[data-merci-title]');
      if (h1) h1.textContent = `Merci ${p}, il est à toi`;
      sessionStorage.removeItem('ps_planning_prenom');
    }
  } catch {}
</script>
