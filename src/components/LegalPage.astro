---
import type { LegalDoc } from '../data/legal';
interface Props { doc: LegalDoc }
const { doc } = Astro.props;
const slug = (h: string) => h.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
/** Les « [À COMPLÉTER : …] » restent visibles, en surbrillance, tant que la cliente n'a pas fourni l'information.
 *  Une adresse « www.… » devient un lien qui s'ouvre dans un nouvel onglet (site du médiateur). */
const parts = (t: string) => t.split(/(\[À COMPLÉTER[^\]]*\]|www\.[a-z0-9.-]+\.[a-z]{2,})/g).map((p) => ({ text: p, todo: p.startsWith('[À COMPLÉTER'), url: p.startsWith('www.') }));
const hasTodo = doc.sections.some((s) => s.body.some((b) => (Array.isArray(b) ? b.join(' ') : b).includes('[À COMPLÉTER')));
---
<section class="lp">
  <div class="container inner">
    <p class="eyebrow">{doc.eyebrow}</p>
    <h1>{doc.title}</h1>
    <p class="lead">{doc.intro}</p>
    <p class="updated">Dernière mise à jour : {doc.updated}</p>

    {hasTodo && (
      <p class="todo-banner" role="status">Page en cours de finalisation : les mentions surlignées attendent les informations de Petit Sommeil.</p>
    )}

    <nav class="toc" aria-label="Sommaire">
      <ol>{doc.sections.map((s) => <li><a href={`#${slug(s.h)}`}>{s.h}</a></li>)}</ol>
    </nav>

    {doc.sections.map((s) => (
      <section class="sec" id={slug(s.h)} aria-labelledby={`${slug(s.h)}-t`}>
        <h2 id={`${slug(s.h)}-t`}>{s.h}</h2>
        {s.body.map((b) => (Array.isArray(b)
          ? <ul>{b.map((li) => <li>{parts(li).map((p) => p.todo ? <mark class="todo">{p.text}</mark> : p.url ? <a href={`https://${p.text}`} target="_blank" rel="noopener">{p.text}<span class="sr-only"> (nouvel onglet)</span></a> : p.text)}</li>)}</ul>
          : <p>{parts(b).map((p) => p.todo ? <mark class="todo">{p.text}</mark> : p.url ? <a href={`https://${p.text}`} target="_blank" rel="noopener">{p.text}<span class="sr-only"> (nouvel onglet)</span></a> : p.text)}</p>))}
      </section>
    ))}
  </div>
</section>

<style>
  .lp { padding: 56px 0 var(--section-y); }
  .todo-banner { margin: 0 0 20px; padding: 12px 16px; background: var(--gold-300); color: var(--navy-900); border-radius: var(--radius-md); font-size: var(--fs-sm); font-weight: var(--fw-semibold); }
  .todo { background: var(--gold-300); color: var(--navy-900); padding: 1px 6px; border-radius: 4px; font-weight: var(--fw-semibold); }
  .inner { max-width: 760px; }
  h1 { margin-bottom: 14px; }
  .lead { color: var(--text-body); margin-bottom: 8px; }
  .updated { font-size: var(--fs-sm); color: var(--text-body); margin: 0 0 32px; }

  .toc { background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 22px 26px; margin-bottom: 12px; }
  .toc ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 7px; font-size: var(--fs-sm); }
  .toc a { color: var(--text-body); text-decoration: none; }
  .toc a:hover { color: var(--text-strong); text-decoration: underline; text-underline-offset: 3px; }

  .sec { scroll-margin-top: 96px; padding-top: 34px; }
  .sec h2 { font-size: var(--fs-h3); margin-bottom: 12px; }
  .sec p { margin: 0 0 14px; }
  .sec ul { margin: 0 0 14px; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; }
  .sec a { color: var(--text-strong); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1.5px; overflow-wrap: anywhere; }
  .sec a:hover { color: var(--navy-700); text-decoration-thickness: 2px; }
</style>
