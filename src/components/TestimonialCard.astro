---
/**
 * Un avis Google, présenté comme sur la fiche d'établissement de Sarah : avatar avec initiale,
 * nom, cinq étoiles, texte cité tel quel (emojis compris), logo Google.
 * Les couleurs du logo et des étoiles sont celles de Google, pas du design system : c'est une
 * citation d'un service tiers, elle doit être reconnaissable.
 */
interface Props { quote: string; author: string; rating?: number }
const { quote, author, rating = 5 } = Astro.props;
const initial = author.trim()[0];
---
<figure class="avis">
  <div class="head">
    <span class="avatar" aria-hidden="true">{initial}</span>
    <div class="who">
      <span class="name">{author}</span>
      <span class="stars" role="img" aria-label={`${rating} étoiles sur 5`}>{'★'.repeat(rating)}{'☆'.repeat(5 - rating)}</span>
    </div>
    <svg class="g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
  </div>
  <blockquote><p>{quote}</p></blockquote>
  <figcaption class="src">Avis publié sur Google</figcaption>
</figure>
<style>
  .avis { margin: 0; background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .head { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--navy-800); color: var(--text-on-dark); font-weight: var(--fw-bold); font-size: 17px; display: inline-flex; align-items: center; justify-content: center; }
  .who { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-weight: var(--fw-bold); color: var(--text-strong); font-size: 15px; line-height: 1.2; }
  .stars { color: #FBBC04; font-size: 15px; letter-spacing: 0.06em; line-height: 1; }
  .g { width: 22px; height: 22px; flex-shrink: 0; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-body); }
  .src { margin-top: auto; font-size: var(--fs-xs); color: var(--text-muted); }
</style>
