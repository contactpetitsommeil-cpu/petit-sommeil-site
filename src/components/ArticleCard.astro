---
import Photo from './Photo.astro';
import type { PhotoId } from '../data/photos';
interface Props { href: string; title: string; description: string; category: string; date: Date; readingTime?: string; featured?: boolean; image?: PhotoId }
const { href, title, description, category, date, readingTime, featured = false, image } = Astro.props;
const jour = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
const iso = date.toISOString().slice(0, 10);
---
<article class:list={['ac', featured && 'featured']}>
  <!-- L'image de l'article (08/09), décorative sur la carte : le titre porte le lien, l'alt réel est sur la page de l'article. -->
  <div class="media" aria-hidden="true">
    {image && <Photo id={image} desktop="carte" alt="" widths={[400, 800, 1200]} sizes={featured ? '(max-width: 800px) calc(100vw - 40px), 520px' : '(max-width: 900px) calc(100vw - 40px), 360px'} />}
  </div>
  <div class="body">
    <p class="meta">
      <span class="cat">{category}</span>
      <time datetime={iso}>{jour}</time>
      {readingTime && <span class="rt">{readingTime} de lecture</span>}
    </p>
    <h2><a href={href}>{title}</a></h2>
    <p class="desc">{description}</p>
    <span class="more" aria-hidden="true">Lire l’article →</span>
  </div>
</article>

<style>
  .ac { display: flex; flex-direction: column; background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; transition: transform var(--dur-base) var(--ease-soft), box-shadow var(--dur-base) var(--ease-soft); }
  .ac:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .media { display: block; height: 180px; background: linear-gradient(150deg, var(--cream-200), var(--gold-300)); overflow: hidden; }
  .media :global(picture), .media :global(img) { width: 100%; height: 100%; }
  .media :global(img) { object-fit: cover; }
  .body { padding: 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }

  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0; font-size: var(--fs-xs); color: var(--text-body); }
  .cat { font-weight: var(--fw-extrabold); letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-strong); }
  .rt::before, time::before { content: '·'; margin-right: 10px; color: var(--ink-300); }

  h2 { font-size: 21px; margin: 0; }
  h2 a { text-decoration: none; }
  h2 a::after { content: ''; position: absolute; inset: 0; }
  .ac { position: relative; }
  h2 a:focus-visible { outline: none; }
  .ac:has(a:focus-visible) { outline: 3px solid var(--focus-ring); outline-offset: 3px; }
  .desc { margin: 0; font-size: var(--fs-sm); }
  .more { margin-top: auto; padding-top: 8px; font-size: var(--fs-sm); font-weight: var(--fw-bold); color: var(--text-strong); }

  /* Article mis en avant : deux colonnes */
  .featured { display: grid; grid-template-columns: 0.9fr 1.1fr; }
  .featured .media { height: 100%; min-height: 260px; }
  .featured .body { padding: 36px 40px; }
  .featured h2 { font-size: var(--fs-h2); }
  .featured .desc { font-size: var(--fs-body); }

  @media (max-width: 800px) {
    .featured { grid-template-columns: 1fr; }
    .featured .media { min-height: 180px; height: 180px; }
    .featured .body { padding: 24px; }
  }
</style>
