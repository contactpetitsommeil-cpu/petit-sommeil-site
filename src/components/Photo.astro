---
/**
 * Une photo du site, à partir des masters JPEG de `src/assets/photos/` (produits par `npm run photos`).
 * Astro fabrique l'AVIF et le WebP à la construction (astro:assets). Deux cadrages possibles : `mobile`,
 * servi sous 720 px par `<source media>`, et `desktop` (nom du cadrage, `all` par défaut). Le hero passe
 * `priority` : chargement immédiat, `fetchpriority="high"` ; tout le reste est lazy.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos, type PhotoId } from '../data/photos';

interface Props {
  id: PhotoId;                // '03-et-toi', voir data/photos.ts
  alt?: string;               // par défaut, l'alt de data/photos.ts
  desktop?: string;           // nom du cadrage, 'all' par défaut
  mobile?: string;            // cadrage servi sous 720 px, optionnel
  widths: number[];           // largeurs générées pour le cadrage desktop
  sizes: string;              // attribut sizes du cadrage desktop
  mobileWidths?: number[];
  mobileSizes?: string;
  priority?: boolean;
  class?: string;
}
const { id, alt, desktop = 'all', mobile, widths, sizes, mobileWidths = [400, 800, 1200], mobileSizes = 'calc(100vw - 40px)', priority = false, class: cls } = Astro.props;

const photo = photos[id];
if (!photo) throw new Error(`Photo inconnue : ${id} (voir src/data/photos.ts)`);
const master = (crop: string) => {
  const m = photo.crops[crop];
  if (!m) throw new Error(`Cadrage ${crop} absent pour ${id} (voir src/data/photos.ts)`);
  return m;
};

async function sources(src: ImageMetadata, ws: number[]) {
  const usable = ws.filter((w) => w <= src.width);
  const w = Math.max(...usable);
  const avif = await getImage({ src, format: 'avif', widths: usable, width: w, quality: 70 });
  const webp = await getImage({ src, format: 'webp', widths: usable, width: w, quality: 80 });
  return { avif, webp, width: src.width, height: src.height };
}
const dSrc = master(desktop);
const d = await sources(dSrc, widths);
const m = mobile ? await sources(master(mobile), mobileWidths) : null;
const fallback = await getImage({ src: dSrc, format: 'jpeg', width: Math.min(1200, dSrc.width), quality: 80 });
---
<picture class={cls}>
  {m && <source media="(max-width: 720px)" type="image/avif" srcset={m.avif.srcSet.attribute} sizes={mobileSizes} width={m.width} height={m.height} />}
  {m && <source media="(max-width: 720px)" type="image/webp" srcset={m.webp.srcSet.attribute} sizes={mobileSizes} width={m.width} height={m.height} />}
  <source type="image/avif" srcset={d.avif.srcSet.attribute} sizes={sizes} width={d.width} height={d.height} />
  <source type="image/webp" srcset={d.webp.srcSet.attribute} sizes={sizes} width={d.width} height={d.height} />
  <img src={fallback.src} width={d.width} height={d.height} alt={alt ?? photo.alt}
    loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
</picture>
<style>
  picture { display: block; }
  img { display: block; width: 100%; height: auto; }
</style>
