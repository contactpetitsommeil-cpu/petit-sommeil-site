---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav } from '../data/site';
const current = Astro.url.pathname.replace(/\.html$/, '') || '/';
---
<header class="header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Petit Sommeil, accueil"><Logo size={36} class="brand-logo" /></a>

    <nav class="nav" id="nav-principale" aria-label="Navigation principale">
      <ul>
        {nav.map((l) => (
          <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav-cta">
        <Button href="/questionnaire" variant="gold" size="sm">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          Prendre rendez-vous
        </Button>
      </div>
    </nav>

    <button class="burger" type="button" aria-expanded="false" aria-controls="nav-principale" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const header = document.querySelector('.header');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
    header?.classList.toggle('is-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });
</script>

<style>
  .header {
    position: sticky; top: 0; z-index: 20;
    background: rgba(248, 243, 234, 0.96);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
  .brand { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 720px) { .brand :global(.brand-logo svg) { height: 30px; } }
  .nav { display: flex; align-items: center; gap: 26px; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 26px; }
  .nav a:not(.btn) {
    font-size: 14.5px; font-weight: var(--fw-semibold); color: var(--text-body); text-decoration: none; white-space: nowrap;
    transition: color var(--dur-base) var(--ease-soft);
  }
  .nav a:not(.btn):hover { color: var(--accent-strong); }
  .nav a[aria-current="page"] { color: var(--text-strong); font-weight: var(--fw-bold); }

  .burger { display: none; background: none; border: 0; width: 44px; height: 44px; padding: 10px; cursor: pointer; flex-direction: column; justify-content: center; gap: 5px; }
  .burger span { display: block; height: 2px; width: 100%; background: var(--navy-900); border-radius: 2px; transition: transform var(--dur-base) var(--ease-soft), opacity var(--dur-base); }

  @media (max-width: 900px) {
    .burger { display: flex; }
    .nav {
      position: fixed; top: 72px; left: 0; right: 0; bottom: 0; background: var(--cream-50);
      flex-direction: column; align-items: stretch; padding: 24px var(--container-pad) 40px; gap: 0;
      transform: translateX(100%); visibility: hidden; pointer-events: none; transition: transform var(--dur-slow) var(--ease-soft), visibility 0s var(--dur-slow);
      overflow-y: auto;
    }
    .is-open .nav { transform: none; visibility: visible; pointer-events: auto; transition-delay: 0s; }
    .nav ul { flex-direction: column; gap: 0; }
    .nav li a:not(.btn) { display: block; padding: 18px 4px; font-size: 18px; border-bottom: 1px solid var(--border); }
    .nav-cta { margin-top: 28px; }
    .is-open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .is-open .burger span:nth-child(2) { opacity: 0; }
    .is-open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
